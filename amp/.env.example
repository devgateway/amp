# AMP + TruBudget Docker environment
# Copy this file to .env in the repo root, fill in values, then run ./setup.sh
# Do NOT commit .env to version control.

# ── Server ─────────────────────────────────────────────────────────────────
# The private IP of this server
SERVER_IP=192.168.1.100

# ── Ports (host-side) ──────────────────────────────────────────────────────
AMP_PORT=8080
TRUBUDGET_UI_PORT=3000
TRUBUDGET_API_PORT=8081

# ── AMP ────────────────────────────────────────────────────────────────────
# Docker image produced by the GitHub Actions CI pipeline (build-push-ecr.yml).
# AMP_IMAGE → ECR repository URL (no tag)
# AMP_TAG   → branch or release tag built by CI (e.g. develop, main, v1.2.0)
AMP_IMAGE=798366298150.dkr.ecr.us-east-1.amazonaws.com/amp/webapp
AMP_TAG=task/AMP-31085/Update-TruBudget-Branch-with-latest-develolp

# AWS credentials used by setup.sh to authenticate to ECR before pulling
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

AMP_DB_NAME=amp
AMP_DB_USER=amp
AMP_DB_PASSWORD=change_me_amp_db_pass

# Optional: label shown in the AMP footer next to the version number.
# Replaces the raw CI branch/tag name (e.g. task-AMP-31085-...) with something readable.
# Leave empty to show the branch name as-is.
AMP_BUILD_LABEL=v4.0

# Optional: full footer text shown below the version line.
# Replaces whatever is stored in the DB for the footer key.
# Example: "AMP Senegal — Developed by Development Gateway"
# Leave empty to keep the DB value unchanged.
AMP_FOOTER_TEXT=TruBudget Enabled AMP Cameroon Developed by Development Gateway with the support of the European Union, GIZ and UNDP

# Tomcat JVM heap (e.g. 8g for a 16 GB instance)
AMP_JVM_HEAP=2g

# SMTP relay for AMP outbound mail (optional)
SMTP_HOST=smtp.example.org
SMTP_FROM=noreply@example.org

# Docker-internal URL the AMP JVM uses to reach TruBudget API.
TRUBUDGET_BASE_URL=http://host.docker.internal:8081/
TRUBUDGET_ENABLED=false

# ── TruBudget (cloned from official repo) ─────────────────────────────────
# Git tag or branch — use a specific tag like v2.10.0 for production stability
TRUBUDGET_TAG=main
# Docker image tag used inside TruBudget's own compose (latest, main, or v2.x.x)
TRUBUDGET_VERSION=latest

# Organisation name on the blockchain (no spaces)
TRUBUDGET_ORG=AMP_ORG

# Vault secret used to encrypt private keys — keep this safe
TRUBUDGET_VAULT_SECRET=change_me_vault_secret

# Root admin password for first-time TruBudget login (username: root)
TRUBUDGET_ROOT_SECRET=change_me_root_secret

# Blockchain internal RPC password
TRUBUDGET_RPC_PASSWORD=change_me_rpc_password
