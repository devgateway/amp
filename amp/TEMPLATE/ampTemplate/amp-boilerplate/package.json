{
  "name": "@devgateway/amp-boilerplate",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/devgateway/amp-boilerplate.git"
  },
  "description": "Header and footer used in parts of AMP",
  "main": "index.js",
  "author": "phil,eperez",
  "browserify": {
    "transform": [
      "brfs"
    ]
  },
  "scripts": {
    "build": "gulp build"
  },
  "devDependencies": {
    "backbone": "1.1.2",
    "backbone.localstorage": "^1.1.16",
    "bootstrap": "3.4.1",
    "brfs": "1.4.3",
    "browserify": "17.0.0",
    "del": "1.2.1",
    "fancy-log": "1.3.3",
    "gulp": "4.0.2",
    "gulp-jscs": "4.1.0",
    "gulp-jshint": "2.1.0",
    "gulp-load-plugins": "2.0.7",
    "gulp-plumber": "1.2.1",
    "gulp-streamify": "1.0.2",
    "gulp-uglify": "3.0.2",
    "jquery": "2.1.1",
    "jquery-ui": "1.10.5",
    "jshint-stylish": "2.2.1",
    "underscore": "1.7.0",
    "vinyl-source-stream": "2.0.0"
  },
  "npmName": "amp-boilerplate",
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "*.js"
      ]
    }
  ],
  "publishConfig": {
    "publishConfig": {
      "@devgateway:registry": "https://npm.pkg.github.com"
    },
    "tag": "latest"
  },
  "dependencies": {
    "amp-translate": "^0.0.1"
  }
}
