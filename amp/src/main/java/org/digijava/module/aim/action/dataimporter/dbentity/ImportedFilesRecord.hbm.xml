<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="org.digijava.module.aim.action.dataimporter.dbentity.ImportedFilesRecord"
		   table="IMPORTED_FILES_RECORD">

		<cache usage="read-write" />

		<id name="id" column="id" type="java.lang.Long">
			<generator class="org.hibernate.id.enhanced.SequenceStyleGenerator">
				<param name="sequence_name">IMPORTED_FILES_RECORD_SEQ</param>
			</generator>
		</id>

		<property name="fileName" column="file_name" type="java.lang.String" />

		<property name="fileHash" column="file_hash" type="java.lang.String" />

		<property name="processingTimeMillis" column="processing_time_millis" type="java.lang.Long" />

		<property name="uploadedAt" column="uploaded_at" type="timestamp" />

		<property name="importStatus" column="import_status">
			<type name="org.hibernate.type.EnumType">
				<param name="enumClass">org.digijava.module.aim.action.dataimporter.dbentity.ImportStatus</param>
				<param name="useNamed">false</param>
			</type>
		</property>

	</class>
</hibernate-mapping>
