<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="org.digijava.module.aim.dbentity.AmpIndicator" table="AMP_INDICATOR">
		<cache usage="read-write" />
		<id name="indicatorId" column="indicator_id">
			<generator class="org.hibernate.id.enhanced.SequenceStyleGenerator">
				<param name="sequence_name">AMP_INDICATOR_seq</param>
			</generator>
		</id>

		<property name="name" column="name" type="java.lang.String" />
		<property name="code" column="code" type="java.lang.String" unique="true" />
		<property name="description" column="description" type="text" />
		<property name="type" column="type" type="java.lang.String" />
		<property name="creationDate" column="creation_date" type="java.util.Date" />
		<property name="defaultInd" column="default_ind" type="java.lang.Boolean" />
		<property name="unit" column="unit" type="java.lang.String" />

		<property name="comments" column="Comments" type="java.lang.String" />

		<set name="indicatorValues" lazy="true" inverse="true" cascade="all-delete-orphan">
			<cache usage="read-write" />
			<key column="indicator_id" />
			<one-to-many class="org.digijava.module.aim.dbentity.AmpIndicatorGlobalValue" />
		</set>

		<many-to-one name="indicatorsCategory" column="indicators_category"
			class="org.digijava.module.categorymanager.dbentity.AmpCategoryValue" cascade="none" lazy="false"  />

		<many-to-one name="risk" column="risk"
			class="org.digijava.module.aim.dbentity.AmpIndicatorRiskRatings" cascade="none" />

		<set name="sectors" table="AMP_SECTOR_INDICATOR" lazy="true" cascade="none">
			<cache usage="read-write" />
			<key column="indicator_id" />
			<many-to-many class="org.digijava.module.aim.dbentity.AmpSector" column="amp_sector_id" />
		</set>

		<many-to-one name="program" column="program_id" class="org.digijava.module.aim.dbentity.AmpTheme" cascade="none" />

		<set name="valuesActivity" lazy="true" inverse="true" cascade="delete-orphan">
				<key column="indicator_id"/>
				<one-to-many class="org.digijava.module.aim.dbentity.IndicatorConnection"/>
		</set>

		<set name="valuesTheme" lazy="true" inverse="true" cascade="delete-orphan">
				<key column="indicator_id"/>
				<one-to-many class="org.digijava.module.aim.dbentity.IndicatorConnection"/>
		</set>

		<many-to-one name="outcome" column="outcome_id" class="org.digijava.module.aim.dbentity.AmpOutcome" cascade="none" />
		<many-to-one name="output" column="output_id" class="org.digijava.module.aim.dbentity.AmpOutput" cascade="none" />
		<property name="relevanceForClimateChange" column="relevance_for_climate_change" type="java.lang.String" />
		<many-to-one name="indicatorType" column="indicator_type_id" class="org.digijava.module.categorymanager.dbentity.AmpCategoryValue" cascade="none" />
		<property name="data" column="data" type="java.lang.String" />
		<property name="dataSource" column="data_source" type="java.lang.String" />
		<list name="disaggregation" table="AMP_INDICATOR_DISAGGREGATION" lazy="true" cascade="none">
            <cache usage="read-write" />
            <key column="indicator_id" />
            <list-index column="order_index" />
            <many-to-many class="org.digijava.module.categorymanager.dbentity.AmpCategoryValue" column="category_value_id" />
        </list>
        <many-to-one name="unitOfMeasure" column="unit_of_measure_id" class="org.digijava.module.categorymanager.dbentity.AmpCategoryValue" cascade="none" />
        <property name="calculationMethod" column="calculation_method" type="java.lang.String" />
        <set name="responsibleOrganizations" table="AMP_INDICATOR_ORGANIZATION" lazy="true" cascade="none">
            <cache usage="read-write" />
            <key column="indicator_id" />
            <many-to-many class="org.digijava.module.aim.dbentity.AmpOrganisation" column="organization_id" />
        </set>
        <many-to-one name="frequency" column="frequency_id" class="org.digijava.module.categorymanager.dbentity.AmpCategoryValue" cascade="none" />
		<set name="disaggregationValues" lazy="false" inverse="true" cascade="all-delete-orphan">
            <key column="indicator_id"/>
            <one-to-many class="org.digijava.module.aim.dbentity.AmpIndicatorDisaggregationValue"/>
        </set>
	</class>
</hibernate-mapping>
