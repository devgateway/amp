<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.digijava.module.aim.dbentity">
    <class name="AmpOutcome" table="amp_outcome">
        <id name="id" column="id" type="java.lang.Long">
            <generator class="org.hibernate.id.enhanced.SequenceStyleGenerator">
                <param name="sequence_name">AMP_OUTCOME_seq</param>
            </generator>
        </id>
        <property name="name" column="name" not-null="true"/>
        <property name="description" column="description"/>
        <set name="outputs" cascade="all" inverse="false">
            <key column="outcome_id"/>
            <one-to-many class="AmpOutput"/>
        </set>
    </class>
</hibernate-mapping>
