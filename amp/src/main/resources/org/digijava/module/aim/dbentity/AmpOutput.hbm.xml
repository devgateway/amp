<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.digijava.module.aim.dbentity">
    <class name="AmpOutput" table="amp_output">
        <id name="id" column="id" type="java.lang.Long">
            <generator class="org.hibernate.id.enhanced.SequenceStyleGenerator">
                <param name="sequence_name">AMP_OUTPUT_seq</param>
            </generator>
        </id>
        <property name="name" column="name" not-null="true"/>
        <property name="description" column="description"/>
        <set name="outcomes" table="amp_outcome_output" inverse="true" cascade="all">
            <key column="output_id"/>
            <many-to-many column="outcome_id" class="AmpOutcome"/>
        </set>
    </class>
</hibernate-mapping>

