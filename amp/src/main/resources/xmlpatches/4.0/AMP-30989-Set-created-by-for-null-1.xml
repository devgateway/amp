<?xml version="1.0" encoding="UTF-8"?>
<tns:patch closeOnSuccess="true" retryOnFail="true"
           xmlns:tns="http://docs.ampdev.net/schemas/xmlpatcher" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://docs.ampdev.net/schemas/xmlpatcher ../../doc/xmlpatcher.xsd ">
    <jira>AMP-30989</jira>
    <keyword>Set indicator layer created by</keyword>
    <author>bmokandu</author>
    <description>Set indicator layer created by</description>
    <apply>
        <script>
            <lang delimiter=";" type="postgres"><![CDATA[
             UPDATE amp_indicator_layer set created_by = (select id from dg_user where email = 'admin@amp.org')
             WHERE created_by IS NULL;
                UPDATE amp_indicator_layer set created_by = NULL where access_type=0;

    ]]></lang>
        </script>
    </apply>
</tns:patch>
