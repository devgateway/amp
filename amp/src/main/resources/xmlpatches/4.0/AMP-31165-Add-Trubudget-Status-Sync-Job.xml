<?xml version="1.0" encoding="UTF-8"?>
<tns:patch closeOnSuccess="true" retryOnFail="true"
           xmlns:tns="http://docs.ampdev.net/schemas/xmlpatcher" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://docs.ampdev.net/schemas/xmlpatcher ../../schemas/xmlpatcher.xsd ">
    <jira>AMP-31165</jira>
    <keyword>Job Manager</keyword>
    <keyword>TruBudget Status Sync Job</keyword>
    <author>copilot</author>
    <trigger type="all">
        <condition type="entryInTableMissing" tablename="amp_quartz_job_class"
                   columnname="jc_name" columnvalue="Sync TruBudget project/subproject closed status" />
    </trigger>
    <apply>
        <script>
            <lang delimiter=";" type="postgres">
                INSERT INTO amp_quartz_job_class (jc_id,jc_name, jc_class_fullname)
                VALUES(nextval('amp_quartz_job_class_seq'),'Sync TruBudget project/subproject closed status',
                'org.digijava.module.trubudget.jobs.TruBudgetStatusSyncJob');
            </lang>
        </script>
    </apply>

</tns:patch>
