            <lang delimiter=";" type="postgres"><![CDATA[
            DELETE FROM AMP_ONEPAGER_SECTION WHRE className='org.dgfoundation.amp.onepager.components.features.me.singlecountry.AmpMEFormSectionFeature';

            ]]></lang>
        </script>
    </apply>
</tns:patch>
